# VisionAttend-AI Backend Configuration (Stage 5.1)
# Copy to .env and configure for your local environment

PROJECT_NAME="VisionAttend-AI Backend"
PROJECT_VERSION="0.5.1"
ENVIRONMENT="development"
DEBUG=true

# Host & Server
HOST="0.0.0.0"
PORT=8000

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & Authentication (Change these in production!)
ADMIN_API_KEY="dev_admin_secret_key_change_in_production"
DEVICE_API_KEY="esp32_device_secret_key_change_in_production"

# Face Recognition Model Configuration
# Model files are placed in the backend/models/ directory
MODEL_DIR="models"
FACE_RECOGNITION_MODEL_NAME="w600k_r50.onnx"
ONNX_EXECUTION_PROVIDER="CPUExecutionProvider"
ONNX_INTRA_OP_NUM_THREADS=4

# Biometric & Similarity Thresholds (Configurable, requires empirical calibration)
# Recommended initial ArcFace baseline: MATCH >= 0.65, AMBIGUOUS >= 0.50, else UNKNOWN
SIMILARITY_MATCH_THRESHOLD=0.65
SIMILARITY_AMBIGUOUS_THRESHOLD=0.50

# Image Quality Validation Thresholds
MIN_FACE_WIDTH=48
MIN_FACE_HEIGHT=48
MIN_LAPLACIAN_VARIANCE=50.0
MIN_BRIGHTNESS=25.0
MAX_BRIGHTNESS=235.0

# Database Configuration (Placeholder for Stage 5.2 - do not enable yet)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/visionattend"
DATABASE_POOL_SIZE=10
